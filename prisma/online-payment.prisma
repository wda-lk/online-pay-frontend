generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma-online-payment/client"
}

datasource db {
  provider = "mysql"
  url      = env("ONLINE_PAYMENT_DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  tmpName      String?  @map("tmp_name") @db.VarChar(255)
  nicNumber    String   @unique(map: "user_nic_number_uindex") @map("nic_number") @db.VarChar(255)
  tmpNicNumber String?  @unique(map: "user_tmp_nic_number_uindex") @map("tmp_nic_number") @db.VarChar(255)
  address      String   @db.Text
  tmpAddress   String?  @map("tmp_address") @db.Text
  mobileNumber String   @unique(map: "user_mobile_number_uindex") @map("mobile_number") @db.VarChar(45)
  email        String?  @db.VarChar(255)
  password     String   @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @map("updated_at") @db.DateTime(0)
  gnDivisionId Int      @map("gn_division_id")

  @@index([email], map: "user_email_index")
  @@index([gnDivisionId], map: "user_gn_divisions_id_fk")
  @@map("user")
}
